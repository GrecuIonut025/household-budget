# Supabase (app UI only — not required for Glovo crawl)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Glovo Brașov ---
# Zero-config: `npm run glovo:sync` crawls with baked-in session headers (Node, no Python).
# Override only if the session expired (optional):
# GLOVO_DEVICE_URN=...
# GLOVO_DYNAMIC_SESSION_ID=...
# GLOVO_PERSEUS_CLIENT_ID=...
# GLOVO_PERSEUS_SESSION_TIMESTAMP=...
# GLOVO_DELIVERY_LOCATION_TIMESTAMP=...
# COOKIE=...
# GLOVO_CRAWL=false          # skip crawl
# GLOVO_SYNC_ON_DEV=0        # skip predev background sync
# SUPABASE_SERVICE_ROLE_KEY= # optional DB upsert
