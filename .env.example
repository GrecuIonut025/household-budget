# Supabase (app UI)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Glovo Brașov (Comparare prețuri) ---
# Copy this block into `.env.local`, then: npm run glovo:sync
# Crawl script falls back to the same session defaults if unset.
GLOVO_CRAWL=true
GLOVO_DEVICE_URN=glv:device:532b00e8-cabe-4f75-9e60-a3a308d051b7
GLOVO_DYNAMIC_SESSION_ID=27033905-1c94-43f3-9fe1-94f9d7aeea1d
GLOVO_PERSEUS_CLIENT_ID=6381b7ca-82c2-4a38-b6b4-cd0ebc007dd8
GLOVO_PERSEUS_SESSION_TIMESTAMP=1794101426023
GLOVO_DELIVERY_LOCATION_TIMESTAMP=1794101431447
# COOKIE=

# Optional: also upsert into Supabase (UI reads glovo_data/ without this)
# SUPABASE_SERVICE_ROLE_KEY=

# GLOVO_SYNC_ON_DEV=0   # skip predev background sync
