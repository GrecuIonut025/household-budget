# Supabase project (local: run `supabase start` and copy the values it prints)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — required for `npm run glovo:import` / `glovo:sync` (never expose to the browser).
# The anon/publishable key alone is NOT enough for Glovo upserts.
# Local: `npx supabase status` → service_role key. Hosted: Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# --- Glovo Brașov crawler (local only) ---
# Session headers expire. Copy fresh values from a logged-in glovoapp.com browser
# request (DevTools → Network → any api.glovoapp.com call → Request Headers).
# GLOVO_DEVICE_URN=glv:device:...
# GLOVO_DYNAMIC_SESSION_ID=...
# GLOVO_PERSEUS_CLIENT_ID=...
# GLOVO_PERSEUS_SESSION_TIMESTAMP=...
# GLOVO_DELIVERY_LOCATION_TIMESTAMP=...
# COOKIE=...
# Optional: GLOVO_USER_AGENT=...  GLOVO_PYTHON=python3  GLOVO_OUTPUT_DIR=glovo_data
#
# Local sync behaviour:
#   npm run predev          → background import of cached/fixture JSON (does not crawl)
#   npm run glovo:sync      → foreground import
#   GLOVO_CRAWL=1 npm run glovo:sync   → crawl then import (slow)
#   GLOVO_SYNC_ON_DEV=0     → skip predev sync entirely
