# Supabase project (local: run `supabase start` and copy the values it prints)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Glovo Brașov (simple local flow) ---
# 1) Paste session headers from a logged-in glovoapp.com request (DevTools → Network).
# 2) Set GLOVO_CRAWL=true
# 3) npm run glovo:sync
# 4) Open Comparare prețuri — it reads glovo_data/all_products.json (no service role needed).
#
# GLOVO_DEVICE_URN=glv:device:...
# GLOVO_DYNAMIC_SESSION_ID=...
# GLOVO_PERSEUS_CLIENT_ID=...
# GLOVO_PERSEUS_SESSION_TIMESTAMP=...
# GLOVO_DELIVERY_LOCATION_TIMESTAMP=...
# COOKIE=...
GLOVO_CRAWL=true

# Optional: also upsert into Supabase (Comparare works without this).
# SUPABASE_SERVICE_ROLE_KEY=

# Optional tweaks:
# GLOVO_USER_AGENT=...
# GLOVO_PYTHON=python3
# GLOVO_OUTPUT_DIR=glovo_data
# GLOVO_SYNC_ON_DEV=0   → skip predev background sync
